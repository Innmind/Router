{
    "name": "innmind/router",
    "type": "library",
    "description": "HTTP router",
    "keywords": ["http", "router"],
    "homepage": "http://github.com/Innmind/Router",
    "license": "MIT",
    "authors": [
        {
            "name": "Baptiste Langlade",
            "email": "baptiste.langlade@hey.com"
        }
    ],
    "support": {
        "issues": "http://github.com/Innmind/Router/issues"
    },
    "require": {
        "php": "~8.4",
        "innmind/url": "dev-next",
        "innmind/immutable": "dev-next",
        "innmind/http": "dev-next",
        "innmind/url-template": "dev-next",
        "innmind/filesystem": "dev-next",
        "innmind/io": "dev-next",
        "innmind/media-type": "dev-next",
        "innmind/validation": "dev-next",
        "innmind/ip": "dev-next",
        "innmind/time-continuum": "dev-next"
    },
    "autoload": {
        "psr-4": {
            "Innmind\\Router\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Innmind\\Router\\": "tests/",
            "Fixture\\Innmind\\Router\\": "fixtures/"
        }
    },
    "require-dev": {
        "innmind/static-analysis": "^1.2.1",
        "innmind/black-box": "~6.5",
        "innmind/coding-standard": "~2.0"
    }
}
